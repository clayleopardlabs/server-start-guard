@echo off
setlocal
title Server Start Guard Installer

echo.
echo Installing Server Start Guard for opencode...
echo.

set "SSG_PKG=%~dp0"
set "SSG_"

powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand %SSG_B64%

if errorlevel 1 (
  echo.
  echo Install failed. Make sure you downloaded the whole release folder,
  echo and that opencode is installed under this Windows user account.
  echo.
  pause
  exit /b 1
)

echo.
echo Install complete.
echo Server Start Guard is now installed for opencode.
echo Restart opencode to load the plugin.
echo.
if not defined SSG_NO_PAUSE pause